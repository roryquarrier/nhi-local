---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.meetingPoint;
const vi = COPY.vi.sections.meetingPoint;

// Embedded map centred on My An Beach — surf (in season) is the primary
// service. SUP/freedive return to Man Thai in the flat-water season.
const mapsEmbedUrl =
  'https://www.google.com/maps?q=My+An+Beach,+Đà+Nẵng&output=embed';
const mapsSearchUrl =
  'https://www.google.com/maps/search/?api=1&query=My+An+Beach+Da+Nang';
---

<section id="meeting-point" class="section">
  <div class="section-wide grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-semibold text-linen sm:text-4xl">
        <span data-lang="en">{en.title}</span>
        <span data-lang="vi">{vi.title}</span>
      </h2>
      <p class="mt-5 leading-relaxed text-lilac">
        <span data-lang="en">{en.body}</span>
        <span data-lang="vi">{vi.body}</span>
      </p>
      <a
        href={mapsSearchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full border border-tungsten px-6 py-3 font-semibold text-tungsten transition-colors hover:bg-tungsten hover:text-dawn"
      >
        <span data-lang="en">Open in Google Maps</span>
        <span data-lang="vi">Mở trong Google Maps</span>
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl aspect-[4/3] w-full">
      <iframe
        src={mapsEmbedUrl}
        width="100%"
        height="100%"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map of My An Beach, Da Nang"
      ></iframe>
    </div>
  </div>
</section>
