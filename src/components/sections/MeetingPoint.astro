---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.meetingPoint;
const vi = COPY.vi.sections.meetingPoint;

// TODO: exact Google Maps pin for the Man Thai meeting point is not confirmed.
// Until it is, we link a Maps search for the beach rather than a fabricated pin.
const mapsSearchUrl =
  'https://www.google.com/maps/search/?api=1&query=Man+Thai+Beach+Da+Nang';
---

<section id="meeting-point" class="section">
  <div class="section-wide grid items-center gap-10 md:grid-cols-2">
    <div>
      <p class="font-mono text-sm tracking-widest text-sea uppercase">
        <span data-lang="en">{en.eyebrow}</span>
        <span data-lang="vi">{vi.eyebrow}</span>
      </p>
      <h2 class="mt-3 text-3xl font-semibold text-linen sm:text-4xl">
        <span data-lang="en">{en.title}</span>
        <span data-lang="vi">{vi.title}</span>
      </h2>
      <p class="mt-5 leading-relaxed text-lilac">
        <span data-lang="en">{en.body}</span>
        <span data-lang="vi">{vi.body}</span>
      </p>
      <a
        href={mapsSearchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full border border-tungsten px-6 py-3 font-semibold text-tungsten transition-colors hover:bg-tungsten hover:text-dawn"
      >
        <span data-lang="en">Open in Google Maps</span>
        <span data-lang="vi">Mở trong Google Maps</span>
      </a>
    </div>

    <!-- TODO: replace with an embedded map once the exact pin is confirmed -->
    <div
      class="placeholder aspect-[4/3] w-full rounded-2xl"
      role="img"
      aria-label="Map of Man Thai Beach meeting point — exact pin to be confirmed"
    >
      placeholder-map-man-thai.jpg · 4:3 · exact pin TBC
    </div>
  </div>
</section>
