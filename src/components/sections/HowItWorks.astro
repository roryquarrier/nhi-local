---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.howItWorks;
const vi = COPY.vi.sections.howItWorks;
---

<section id="how-it-works" class="section" style="padding-top: 3.5rem; padding-bottom: 3.5rem;">
  <div class="section-wide">
    <h2 class="font-display text-3xl font-normal text-linen sm:text-4xl">
      <span data-lang="en">{en.title}</span>
      <span data-lang="vi">{vi.title}</span>
    </h2>

    <!-- Vertical narrative instead of 3-col grid: each step is a numbered
         line with the step body flowing inline beside it. No cards, no
         icons, no equal-height columns. -->
    <ol class="mt-10 space-y-8 md:space-y-10">
      {
        en.steps.map((step, i) => (
          <li class="flex gap-5 md:gap-8">
            <span class="font-mono text-sm text-sea shrink-0 pt-1 tabular-nums">
              {step.n}
            </span>
            <div class="min-w-0">
              <h3 class="text-lg font-semibold text-linen">
                <span data-lang="en">{step.title}</span>
                <span data-lang="vi">{vi.steps[i]?.title}</span>
              </h3>
              <p class="mt-1.5 leading-relaxed text-lilac max-w-md">
                <span data-lang="en">{step.body}</span>
                <span data-lang="vi">{vi.steps[i]?.body}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
