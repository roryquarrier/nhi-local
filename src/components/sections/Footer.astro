---
import { COPY, ZALO_LINK } from '../../lib/translations';
const en = COPY.en.sections.footer;
const vi = COPY.vi.sections.footer;

const year = new Date().getFullYear();
const whatsappLink = 'https://wa.me/84905002813';
---

<footer class="border-t border-lilac/15 px-6 py-14 sm:px-10">
  <div class="section-wide grid gap-10 md:grid-cols-2">
    <div>
      <p class="wordmark text-lg text-linen">NHI&nbsp;LOCAL</p>
      <p class="mt-3 max-w-xs text-sm text-lilac">
        <span data-lang="en">{en.tagline}</span>
        <span data-lang="vi">{vi.tagline}</span>
      </p>
      <p class="mt-3 text-sm text-lilac/70">Man Thai Beach · Da Nang · Vietnam</p>
    </div>

    <div>
      <p class="text-sm font-mono text-lilac/60 uppercase tracking-widest">
        <span data-lang="en">{en.socials}</span>
        <span data-lang="vi">{vi.socials}</span>
      </p>
      <ul class="mt-4 flex flex-wrap gap-4 text-sm">
        <li>
          <a
            href="https://www.instagram.com/nhilocal"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            Instagram
          </a>
        </li>
        <li>
          <a
            href="https://www.tiktok.com/@thuynhile_"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
            TikTok
          </a>
        </li>
        <li>
          <a
            href="https://www.facebook.com/share/1J98ZsA5gF/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            Facebook
          </a>
        </li>
        <li>
          <a
            href={ZALO_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>
            Zalo
          </a>
        </li>
        <li>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <p class="section-wide mt-12 text-xs text-lilac/50">
    © {year} Nhi Local ·
    <span data-lang="en">{en.rights}</span>
    <span data-lang="vi">{vi.rights}</span>
  </p>
</footer>
