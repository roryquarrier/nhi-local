---
import { COPY, ZALO_LINK } from '../../lib/translations';
const en = COPY.en.sections.footer;
const vi = COPY.vi.sections.footer;

const year = new Date().getFullYear();
---

<footer class="border-t border-lilac/15 px-6 py-14 sm:px-10">
  <div class="section-wide grid gap-10 md:grid-cols-3">
    <div>
      <p class="wordmark text-lg text-linen">NHI&nbsp;LOCAL</p>
      <p class="mt-3 max-w-xs text-sm text-lilac">
        <span data-lang="en">{en.tagline}</span>
        <span data-lang="vi">{vi.tagline}</span>
      </p>
      <p class="mt-3 text-sm text-lilac/70">Man Thai Beach · Da Nang · Vietnam</p>
    </div>

    <div>
      <p class="font-mono text-xs tracking-widest text-sea uppercase">
        <span data-lang="en">{en.contact}</span>
        <span data-lang="vi">{vi.contact}</span>
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a
            href="tel:+84905002813"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg> +84 90 500 28 13
          </a>
        </li>
        <li>
          <a
            href={ZALO_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg> Zalo
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-mono text-xs tracking-widest text-sea uppercase">
        <span data-lang="en">{en.socials}</span>
        <span data-lang="vi">{vi.socials}</span>
      </p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a
            href="https://www.facebook.com/share/1J98ZsA5gF/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg> Facebook
          </a>
        </li>
        <li>
          <a
            href="https://www.instagram.com/nhilocal"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-lilac transition-colors hover:text-tungsten"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg> Instagram
          </a>
        </li>
        <!-- TODO: TikTok handle https://www.tiktok.com/@thuynhile_ is Nhi's
             personal account — whether it should be linked is not confirmed,
             so it is intentionally not rendered. -->
      </ul>
    </div>
  </div>

  <p class="section-wide mt-12 text-xs text-lilac/50">
    © {year} Nhi Local ·
    <span data-lang="en">{en.rights}</span>
    <span data-lang="vi">{vi.rights}</span>
  </p>
</footer>
