---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.faq;
const vi = COPY.vi.sections.faq;

// Items whose answer is a TODO marker are NOT shown — no fabricated answers.
const isTodo = (a: string) => a.startsWith('<!-- TODO');
const enItems = en.items.filter((i) => !isTodo(i.a));
const viItems = vi.items.filter((i) => !isTodo(i.a));
---

<section id="faq" class="section" style="padding-top: 3.5rem; padding-bottom: 4rem;">
  <div class="section-narrow">
    <h2 class="font-display text-3xl font-normal text-linen sm:text-4xl">
      <span data-lang="en">{en.title}</span>
      <span data-lang="vi">{vi.title}</span>
    </h2>

    <div class="mt-8" data-lang="en">
      {
        enItems.map((item) => (
          <details class="group border-b border-lilac/15 py-4">
            <summary class="cursor-pointer list-none font-semibold text-linen transition-colors group-open:text-tungsten hover:text-tungsten">
              {item.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-lilac">{item.a}</p>
          </details>
        ))
      }
    </div>
    <div class="mt-8" data-lang="vi">
      {
        viItems.map((item) => (
          <details class="group border-b border-lilac/15 py-4">
            <summary class="cursor-pointer list-none font-semibold text-linen transition-colors group-open:text-tungsten hover:text-tungsten">
              {item.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-lilac">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
