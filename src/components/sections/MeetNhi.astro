---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.meetNhi;
const vi = COPY.vi.sections.meetNhi;

const base = import.meta.env.BASE_URL;
const meetVideo = base + 'media/meet_nhi_paddle.mp4';
---

<section id="meet-nhi" class="section" style="padding-top: 7rem; padding-bottom: 7rem;">
  <div class="section-wide grid items-center gap-10 md:grid-cols-2">
    <!-- Video of Nhi paddleboarding with guests on Man Thai Beach -->
    <div class="overflow-hidden rounded-2xl aspect-[9/16] max-h-[70vh]">
      <video
        src={meetVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        class="h-full w-full object-cover"
        aria-label="Nhi paddleboarding with guests at Man Thai Beach"
      ></video>
    </div>

    <div>
      <h2 class="font-display text-3xl font-normal text-linen sm:text-4xl">
        <span data-lang="en">{en.title}</span>
        <span data-lang="vi">{vi.title}</span>
      </h2>
      <p class="mt-5 leading-relaxed text-lilac">
        <span data-lang="en">{en.body}</span>
        <span data-lang="vi">{vi.body}</span>
      </p>
    </div>
  </div>
</section>
