---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.media;
const vi = COPY.vi.sections.media;

const base = import.meta.env.BASE_URL;

const slides = [
  { file: 'sup-new-09.jpg',       ratio: 'aspect-[4/5]', label: 'Glide across calm golden-hour water' },
  { file: 'sup-new-05.jpg',       ratio: 'aspect-[4/3]', label: 'Catching a wave with spray flying' },
  { file: 'sup-new-02.jpg',       ratio: 'aspect-[4/5]', label: 'Smiling guest on a colourful board at sunset' },
  { file: 'sup-new-08.jpg',       ratio: 'aspect-[4/3]', label: 'Group floating together on the bay' },
  { file: 'sup-new-06.jpg',       ratio: 'aspect-[4/5]', label: 'Paddling past palm trees and beachfront' },
  { file: 'surfer-wave.jpg',      ratio: 'aspect-[4/3]', label: 'Carving through whitewater at Man Thai' },
  { file: 'sup-lesson-posed.jpg', ratio: 'aspect-[4/5]', label: 'Smiling group with boards and life jackets' },
  { file: 'sup-new-07.jpg',       ratio: 'aspect-[4/3]', label: 'Lesson group with boards on the sand' },
  { file: 'sup-new-03.jpg',       ratio: 'aspect-[4/5]', label: 'Freediving adventure in deep blue water' },
  { file: 'sup-new-01.jpg',       ratio: 'aspect-[4/5]', label: 'Sunset board on a calm beach' },
];
---

<section id="media" class="section">
  <div class="section-wide">
    <h2 class="text-3xl font-semibold text-linen sm:text-4xl">
      <span data-lang="en">{en.title}</span>
      <span data-lang="vi">{vi.title}</span>
    </h2>

    <!-- Horizontal scroll-snap carousel -->
    <div
      class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4"
      aria-label="Photo carousel"
    >
      {
        slides.map((s) => (
          <div class={`shrink-0 snap-start overflow-hidden rounded-xl ${s.ratio} w-64 sm:w-72`}>
            <img
              src={base + 'media/' + s.file}
              alt={s.label}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
