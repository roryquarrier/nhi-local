---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.media;
const vi = COPY.vi.sections.media;

const base = import.meta.env.BASE_URL;

const slides = [
  { file: 'sup-group-sunset.jpg',   ratio: 'aspect-[4/5]', label: 'SUP group at sunset' },
  { file: 'surfer-wave.jpg',        ratio: 'aspect-[4/5]', label: 'Surfing at Man Thai' },
  { file: 'sup-group-beach.jpg',    ratio: 'aspect-[4/5]', label: 'Group lesson on the beach' },
  { file: 'sup-lesson-posed.jpg',   ratio: 'aspect-[4/5]', label: 'Paddlers with their boards' },
  { file: 'sup-new-01.jpg',         ratio: 'aspect-[4/5]', label: 'Paddler balancing on board in flat water' },
  { file: 'sup-new-02.jpg',         ratio: 'aspect-[4/5]', label: 'Instructor demonstrating paddle technique' },
  { file: 'sup-new-03.jpg',         ratio: 'aspect-[4/5]', label: 'Beginners learning SUP together' },
  { file: 'sup-new-04.jpg',         ratio: 'aspect-[4/3]', label: 'Practicing on boards at the beach' },
  { file: 'sup-new-05.jpg',         ratio: 'aspect-[4/3]', label: 'Catching a wave on a SUP board' },
  { file: 'sup-new-06.jpg',         ratio: 'aspect-[4/5]', label: 'Practicing pop-up technique on the water' },
  { file: 'sup-new-07.jpg',         ratio: 'aspect-[4/3]', label: 'Students with surfboards on the beach' },
  { file: 'sup-new-08.jpg',         ratio: 'aspect-[4/3]', label: 'Paddleboarders floating together on calm water' },
  { file: 'sup-new-09.jpg',         ratio: 'aspect-[4/5]', label: 'Demonstrating paddle technique on the water' },
];
---

<section id="media" class="section">
  <div class="section-wide">
    <h2 class="text-3xl font-semibold text-linen sm:text-4xl">
      <span data-lang="en">{en.title}</span>
      <span data-lang="vi">{vi.title}</span>
    </h2>

    <!-- Horizontal scroll-snap carousel -->
    <div
      class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4"
      aria-label="Photo carousel"
    >
      {
        slides.map((s) => (
          <div class={`shrink-0 snap-start overflow-hidden rounded-xl ${s.ratio} w-64 sm:w-72`}>
            <img
              src={base + 'media/' + s.file}
              alt={s.label}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
