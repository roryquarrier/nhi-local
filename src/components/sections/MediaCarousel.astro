---
import { COPY } from '../../lib/translations';
const en = COPY.en.sections.media;
const vi = COPY.vi.sections.media;

const base = import.meta.env.BASE_URL;

const slides = [
  { file: 'sup-group-sunset.jpg',   ratio: 'aspect-[4/5]', label: 'SUP group at sunset' },
  { file: 'surfer-wave.jpg',        ratio: 'aspect-[4/5]', label: 'Surfing at Man Thai' },
  { file: 'sup-group-beach.jpg',    ratio: 'aspect-[4/5]', label: 'Group lesson on the beach' },
  { file: 'sup-lesson-posed.jpg',   ratio: 'aspect-[4/5]', label: 'Paddlers with their boards' },
];
---

<section id="media" class="section">
  <div class="section-wide">
    <p class="font-mono text-sm tracking-widest text-sea uppercase">
      <span data-lang="en">{en.eyebrow}</span>
      <span data-lang="vi">{vi.eyebrow}</span>
    </p>
    <h2 class="mt-3 text-3xl font-semibold text-linen sm:text-4xl">
      <span data-lang="en">{en.title}</span>
      <span data-lang="vi">{vi.title}</span>
    </h2>

    <!-- Horizontal scroll-snap carousel -->
    <div
      class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4"
      aria-label="Photo carousel"
    >
      {
        slides.map((s) => (
          <div class={`shrink-0 snap-start overflow-hidden rounded-xl ${s.ratio} w-64 sm:w-72`}>
            <img
              src={base + 'media/' + s.file}
              alt={s.label}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
