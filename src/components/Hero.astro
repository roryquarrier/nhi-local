---
/**
 * Hero — a 100svh full-bleed video that autoplays once at real speed, with
 * three text beats driven by the video's own currentTime (see heroExperience).
 * Scroll is locked until the clip ends or the reader skips.
 *
 * Three display modes, all driven by classes on <html>:
 *   .intro-active — the video intro is running (set by JS)
 *   .fallback     — reduced-motion / saveData / slow / video failed
 *   neither       — no JS at all; the <noscript> block below pins the static copy
 * The static hero copy is the DEFAULT; the intro hides it, not the other way
 * round, so a client that never runs our JS still lands on a complete hero.
 */
import { COPY, ZALO_LINK, zaloDeepLink } from '../lib/translations';
import LanguageToggleInline from './LanguageToggleInline.astro';

const en = COPY.en;
const vi = COPY.vi;

const base = import.meta.env.BASE_URL;
const heroVideo = base + 'media/hero_danang_sup.mp4';
const heroPoster = base + 'media/hero_poster.jpg';
---

<noscript>
  <style>
    .intro-only {
      display: none !important;
    }
  </style>
</noscript>

<!-- Claim the intro BEFORE the hero below is parsed, so the opening line is on
     the poster at first paint instead of flashing the static copy first.
     This is a pre-paint optimisation only — detectFallback.ts is authoritative
     and revokes the class if it disagrees, so keep this check conservative:
     when in doubt, leave it unset and let the static hero stand. -->
<script is:inline>
  (function () {
    try {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var c = navigator.connection;
      if (c && (c.saveData || /^(slow-)?[23]g$/.test(c.effectiveType || ''))) return;
      document.documentElement.classList.add('intro-active');
    } catch (e) {
      /* static hero stands */
    }
  })();
</script>

<section id="hero-section" class="hero-section relative">
  <div class="hero-video-wrap">
    <video
      id="hero-video"
      autoplay
      muted
      playsinline
      preload="auto"
      poster={heroPoster}
      aria-hidden="true"
    >
      <source src={heroVideo} type="video/mp4" />
    </video>
    <!-- Poster layer for the static fallback -->
    <div class="hero-poster" aria-hidden="true"></div>

    <!-- ===================== Intro text beats ===================== -->
    <!-- Beat 1 is lit at first paint but intentionally has no visible text
         (SUP SURF DIVE removed). The intro-open element is kept so the
         timing windows in heroExperience.ts don't shift. -->
    <div id="intro-open" class="intro-text intro-only is-on items-center justify-center">
      <!-- intentionally empty -->
    </div>

    <div id="intro-mid" class="intro-text intro-only items-end">
      <div class="scrim-bottom w-full p-6 pb-24 sm:p-10 sm:pb-28">
        <p class="max-w-md text-3xl font-semibold text-linen sm:text-4xl">
          <span data-lang="en">{en.hero.intro.mid}</span>
          <span data-lang="vi">{vi.hero.intro.mid}</span>
        </p>
      </div>
    </div>

    <div id="intro-brand" class="intro-text intro-only items-center justify-center">
      <div class="scrim-center max-w-sm px-10 py-16 text-center sm:max-w-xl sm:px-16 sm:py-20">
        <p class="wordmark text-3xl text-linen sm:text-5xl">NHI&nbsp;LOCAL</p>
        <p class="mt-4 font-mono text-xs tracking-widest text-lilac uppercase">
          <span data-lang="en">{en.hero.intro.brandSub}</span>
          <span data-lang="vi">{vi.hero.intro.brandSub}</span>
        </p>
      </div>
    </div>

    <!-- Static hero copy — the default, and the fallback experience.
         Biased left, not centred — avoids the default-attractor centred hero. -->
    <div class="static-only absolute inset-0 z-10">
      <div class="scrim-bottom absolute inset-x-0 bottom-0 h-2/3"></div>
      <!-- .hero-copy is the hook for the VI-only spacing overrides in
           global.css — Vietnamese sets denser than English at the same size. -->
      <div
        class="hero-copy absolute bottom-0 left-0 max-w-md p-6 pb-12 sm:p-10 sm:pb-16 sm:max-w-lg sm:left-12"
      >
        <h1 class="text-4xl font-normal text-linen sm:text-5xl">
          <span data-lang="en">{en.hero.staticTitle}</span>
          <span data-lang="vi">{vi.hero.staticTitle}</span>
        </h1>
        <p class="mt-4 max-w-lg text-lilac">
          <span data-lang="en">{en.hero.staticSubtitle}</span>
          <span data-lang="vi">{vi.hero.staticSubtitle}</span>
        </p>
        <a
          href="#booking"
          class="mt-6 inline-block rounded-full bg-tungsten px-7 py-3 font-semibold text-dawn"
        >
          <span data-lang="en">{en.hero.staticCta}</span>
          <span data-lang="vi">{vi.hero.staticCta}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Skip affordance — subtle, bottom-right, live from the first frame so the
       reader is never held by a clip they didn't ask for. -->
  <button
    id="skip-intro"
    class="skip-intro intro-only rounded-full border border-lilac/30 bg-dawn/70 px-4 py-2 font-mono text-xs tracking-wider text-lilac backdrop-blur-sm transition-colors hover:border-tungsten/60 hover:text-linen"
  >
    <span data-lang="en">{en.hero.intro.skip}</span>
    <span data-lang="vi">{vi.hero.intro.skip}</span>
  </button>

  <!-- Scroll cue — appears once the intro has handed the page back -->
  <div id="scroll-cue" class="scroll-cue intro-only" aria-hidden="true">
    <span class="scroll-cue-arrow">↓</span>
  </div>
</section>

<!-- Sticky header the wordmark hands off to. Carries the booking CTA so both
     funnels are reachable at every scroll position, fallback included. -->
<header id="dock-header" class="dock-header">
  <div class="scrim-top flex items-center justify-evenly gap-4 px-4 py-3 sm:px-6">
    <span class="wordmark text-sm text-linen">NHI&nbsp;LOCAL</span>
    <div class="flex items-center gap-3">
      <!-- EN funnel: cal.com popup (embed auto-binds data-cal-link) -->
      <button
        data-lang="en"
        data-cal-namespace="sup"
        data-cal-link="rory-quarrier-nsavjf/sup"
        data-cal-config='{"layout":"month_view"}'
        class="rounded-full bg-tungsten px-5 py-2 text-sm font-semibold text-dawn"
      >
        {en.nav.book}
      </button>
      <!-- VI funnel: Zalo deep link -->
      <a
        data-lang="vi"
        href={zaloDeepLink('vi')}
        data-zalo={ZALO_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-tungsten px-5 py-2 text-sm font-semibold text-dawn"
      >
        {vi.nav.book} Zalo
      </a>
      <!-- Language toggle -->
      <LanguageToggleInline />
    </div>
  </div>
</header>

<script>
  import '../lib/heroExperience';
</script>
