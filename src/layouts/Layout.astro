---
interface Props {
  lang?: 'en' | 'vi';
  title?: string;
  description?: string;
  /** Absolute URL. <link rel="canonical"> is emitted only when set. */
  canonical?: string;
  /** hreflang set. Undefined = today's homepage pair (relative "/" and "/?lang=vi"). */
  alternates?: { en?: string; vi?: string; xDefault?: string };
  ogType?: 'website' | 'article';
  ogUrl?: string;
  /** Blog pages: html[lang] is authoritative; resolver only persists it to localStorage. */
  lockLang?: boolean;
}

const lang = Astro.props.lang ?? 'en';
const title = Astro.props.title ?? 'Nhi Local — Surf Lessons on My An Beach, Da Nang';
const description =
  Astro.props.description ??
  'Beginner-friendly surf lessons on My An Beach, Da Nang — surf season is here. Stand-up paddleboard (SUP) and freedive sessions return to Man Thai Beach when the sea calms. Small groups, equipment provided.';

import '../styles/global.css';

const base = import.meta.env.BASE_URL;

const alternates = Astro.props.alternates ?? { en: '/', vi: '/?lang=vi' };
const ogType = Astro.props.ogType ?? 'website';
const ogUrl = Astro.props.ogUrl ?? 'https://nhilocal.com';
const lockLang = Astro.props.lockLang ?? false;
const canonical = Astro.props.canonical;
---

<!doctype html>
<html lang={lang} data-lang-lock={lockLang ? lang : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- hreflang alternates -->
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
    {alternates.vi && <link rel="alternate" hreflang="vi" href={alternates.vi} />}
    {alternates.xDefault && <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={base + 'og-image.jpg'} />
    <meta property="og:url" content={ogUrl} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={base + 'og-image.jpg'} />

    <!-- Fonts: Be Vietnam Pro (sans, full Vietnamese diacritics) + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />

    <style is:inline set:html={`:root { --hero-poster-url: url("${base}media/hero_poster.jpg"); }`}></style>

    <!-- Resolve language BEFORE first paint: URL param > localStorage > 'en'.
         Static copy is rendered in both languages and toggled via CSS on
         html[lang]; React islands listen for the 'langchange' event. -->
    <script is:inline>
      (function () {
        try {
          var lock = document.documentElement.getAttribute("data-lang-lock");
          if (lock) { localStorage.setItem("nhi-lang", lock); return; }
          var p = new URLSearchParams(location.search).get("lang");
          var s = localStorage.getItem("nhi-lang");
          var l = p === "vi" || p === "en" ? p : s === "vi" || s === "en" ? s : "en";
          document.documentElement.lang = l;
        } catch (e) {
          /* default server-rendered lang stands */
        }
      })();
    </script>

    <!-- cal.com floating popup embed (EN booking funnel).
         The floating button is hidden in VI mode via CSS so only the Zalo path is shown. -->
    <script type="text/javascript" is:inline>
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "sup", { origin: "https://app.cal.com" });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      Cal.ns.sup("ui", { "hideEventTypeDetails": false, "layout": "month_view" });
    </script>

    <!-- Hide cal.com floating button in VI mode (VI books via Zalo).
         Selector variants cover current cal.com embed markup; the canonical
         rules also live in global.css. -->
    <style is:global>
      html[lang="vi"] #cal-namespace-sup-floating-button,
      html[lang="vi"] .cal-embed-floating-button,
      html[lang="vi"] button[data-cal-namespace="sup"] {
        display: none !important;
      }
    </style>

    <slot name="head" />
  </head>
  <body class="bg-dawn text-linen font-sans antialiased">
    <slot />
  </body>
</html>
